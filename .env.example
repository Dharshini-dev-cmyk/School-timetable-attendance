# ============================================================
# School Timetable and Attendance Management System
# Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================

# MySQL (container)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=school_attendance_db

# JWT
JWT_SECRET=SchoolTimetableAttendanceSecretKey256BitLongForHS256Algorithm
APP_JWT_SECRET=SchoolTimetableAttendanceSecretKey256BitLongForHS256Algorithm
APP_JWT_EXPIRATION_MS=86400000

# Role-specific JWT expiry, token blacklist, rate limiting
app.login.max-attempts=5
app.login.lockout-duration-minutes=15

# Spring Profile (docker | local)
SPRING_PROFILES_ACTIVE=docker
